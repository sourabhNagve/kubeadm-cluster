# Copy to config.env and adjust. config.env is git-ignored.
#   cp config.env.example config.env
#
# Plain KEY=value lines only (this file is sourced by bash).

# --- AWS ---
AWS_REGION=us-east-1
# Availability zone suffix; the AZ becomes ${AWS_REGION}${AZ_SUFFIX}, e.g. us-east-1a
AZ_SUFFIX=a

# --- Naming ---
# Prefix for every resource name and the "project" tag. Keep it short, lowercase, no spaces.
CLUSTER=k8s-lab

# --- Network (custom VPC, never the default VPC) ---
VPC_CIDR=10.20.0.0/16
PUB_CIDR=10.20.0.0/24
PRIV_CIDR=10.20.10.0/24
# Fixed private IP of the control plane (must sit inside PRIV_CIDR, not in the first 4 addresses).
CP_IP=10.20.10.10

# --- Instances ---
INSTANCE_TYPE_CP=t3.medium
INSTANCE_TYPE_WORKER=t3.medium
ROOT_VOLUME_GB=30

# --- Kubernetes ---
# Minor version for the pkgs.k8s.io repository (kubeadm, kubelet, kubectl).
K8S_MINOR=v1.36
# Must not overlap with VPC_CIDR or each other.
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
# Calico release, for example v3.31.0. Empty = latest GitHub release at install time.
# Pin it for reproducible builds, and if the GitHub API rate-limits the NAT address.
CALICO_VERSION=
